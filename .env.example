# Google sign-in and cloud progress (Firebase). Copy to .env.local for local development and add the
# same four variables in Vercel → Project → Settings → Environment Variables. Without them the site
# works as before and keeps progress only in the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
